# ============================================================
# AgenticDIA backend configuration
# Copy this file to backend/.env and edit the values.
# pydantic-settings loads ".env" from the directory uvicorn is
# launched from (the backend/ folder via `npm run dev`).
# ============================================================

# --- Local LLM (LM Studio) ---
# LM Studio "Developer / Local Server" must be running on :1234
# with an OpenAI-compatible endpoint (/v1). Any loaded model works;
# set LM_STUDIO_MODEL_FALLBACK to the model id shown in LM Studio.
LM_STUDIO_URL="http://localhost:1234/v1"
LM_STUDIO_API_KEY="lm-studio"
LM_STUDIO_MODEL_FALLBACK="qwen3.5-9b-instruct"

# --- Async-safe context budget injected into every system prompt ---
MAX_CONTEXT_TOKENS=8192
TEMPERATURE=0.0

# --- Rate limiting (Finding #39: guard LLM-facing endpoints) ---
# In-process sliding-window limiter keyed by scope + client IP (per-process).
# Set RATE_LIMIT_ENABLED=false to disable (not recommended in prod).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_LIMIT=30
RATE_LIMIT_CHAT_WINDOW=60
RATE_LIMIT_WORKFLOW_LIMIT=60
RATE_LIMIT_WORKFLOW_WINDOW=60
# Store backing the limiter. Only "in-process" exists today: that REQUIRES
# exactly one uvicorn worker (uvicorn's default). The app refuses to boot
# with --workers N while this store is in use, so 429 protection can never
# silently scale by worker count.
RATE_LIMIT_STORE="in-process"
# Explicitly accept N workers with the in-process store (each worker keeps an
# independent budget -> weaker posture). The app still warns loudly at startup.
# RATE_LIMIT_ALLOW_MULTI_PROCESS_IN_PROCESS=false
# Behind a reverse proxy / load balancer, trust X-Forwarded-For only from your
# own proxy IPs so every client keeps its own bucket (never widen a bucket by
# sending spoofed headers to an untrusted peer).
# TRUST_PROXY_HEADERS=true
# TRUSTED_PROXY_IPS="127.0.0.1,::1,10.0.0.5"

# --- Database ---
# Postgres URL (auto-converted to asyncpg; ssl=require is appended
# automatically for supabase.com hosts). If left unset the backend
# falls back to a local SQLite file backend/app.db.
# DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<db>"

# CORS (comma-separated browser origins; never "*" with credentials) ---
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- SSE pub/sub (see app/event_manager.py) ---
# The event bus is in-process (process-local subscriber queues + replay buffer).
# Like the rate limiter, that REQUIRES exactly one uvicorn worker; the app
# refuses to boot with --workers N unless you explicitly opt in below (which
# produces broken/duplicate event delivery -> not recommended).
SSE_HISTORY_BUFFER_SIZE=1000
# SSE_ALLOW_MULTI_PROCESS_IN_PROCESS=false

# --- Optional ---
# APP_NAME="Enterprise Requirements Architecture Core"
# DEBUG=false
